# Optional: used only by the local runner with --execute or MCP with --enable-executor.
# Supply secrets through your shell or secret manager; never a VITE_ variable.
GENLAYER_EXECUTOR_KEY=
PROOFGUARD_OUTPUT_DIR=outputs
# Required by opt-in MCP execution; keep this durable and outside published assets.
PROOFGUARD_EXECUTION_STATE_DIR=execution-state

# Optional delegated manager. Capabilities must be explicitly listed; no defaults.
GENLAYER_MANAGER_KEY=
PROOFGUARD_MANAGER_CAPABILITIES=
PROOFGUARD_MANAGER_STATE_DIR=manager-state
# Separate HTTP report vault. Never use VITE_ for service credentials.
PROOFGUARD_REPORT_TOKEN=
PROOFGUARD_REPORT_DIR=report-vault-data
PROOFGUARD_REPORT_WORKFLOWS=
PROOFGUARD_REPORT_PORT=8788
# MCP delivery only; the fixed service origin.
PROOFGUARD_REPORT_ENDPOINT=http://127.0.0.1:8788
