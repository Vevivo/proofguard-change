# Optional: used only by the local runner with --execute or MCP with --enable-executor.
# Supply secrets through your shell or secret manager; never a VITE_ variable.
GENLAYER_EXECUTOR_KEY=
PROOFGUARD_OUTPUT_DIR=outputs
# Required by opt-in MCP execution; keep this durable and outside published assets.
PROOFGUARD_EXECUTION_STATE_DIR=execution-state
