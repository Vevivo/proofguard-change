{
  "name": "proofguard-change",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Versioned evidence, independent GenLayer reviews and revision-bound permissions for agent workflows.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.arns.config.ts --host 127.0.0.1",
    "build": "vite build --config vite.arns.config.ts",
    "build:arns": "npm run build",
    "preview": "vite preview --config vite.arns.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:contracts && npm run test:client",
    "test:contracts": "python3 tests/change_network_unit.py && python3 tests/change_network_evidence.py && python3 tests/change_contract_unit.py",
    "test:client": "node --test tests/*.test.mjs",
    "agent:change": "node agents/change-network-runner.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:correction": "node scripts/verify-correction.mjs",
    "reproduce:correction": "node scripts/reproduce-correction.mjs",
    "agent:mcp": "node agents/mcp-server.mjs",
    "verify:agent": "node scripts/probe-agent-connector.mjs"
  },
  "dependencies": {
    "@ardrive/turbo-sdk": "^1.42.0",
    "@dha-team/arbundles": "1.0.4",
    "@metamask/connect-evm": "2.1.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "buffer": "6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "genlayer-js": "2.0.0-rc.1",
    "genlayer-studionet": "npm:genlayer-js@1.1.8",
    "gsap": "3.12.5",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "viem": "^2.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vite-plugin-node-polyfills": "0.28.0"
  },
  "keywords": [
    "genlayer",
    "agent-tank",
    "intelligent-contracts",
    "evidence",
    "arweave",
    "ar-io"
  ],
  "license": "MIT",
  "homepage": "https://proofguardchange.ar.io"
}
